# Copy this file to ".env" and fill in your real key.
# Rainbet affiliate API key — server-side only.
# Do NOT prefix with VITE_, or Vite would expose it to the browser bundle.
RAINBET_API_KEY=your_rainbet_api_key_here

# ---- Launch settings (all optional; see README "Search, analytics and contact") ----
# The public address used in canonical links, the sitemap and share tags.
# Defaults to https://tegens.bet when empty.
SITE_URL=
# Google Search Console "HTML tag" verification: paste only the content="…" value.
GOOGLE_SITE_VERIFICATION=
# GA4 measurement ID (G-XXXXXXXXXX). Empty = no analytics and no cookie banner.
GA_MEASUREMENT_ID=
# Discord webhook for admin alerts AND the /contact form. Empty = the contact form
# tells visitors to use Discord instead (it never pretends to send).
DISCORD_ADMIN_WEBHOOK=
